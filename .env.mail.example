# Copy to .env.mail; never put SMTP authorization codes in chat or Git.
EMAIL_SMTP_HOST=smtp.163.com
EMAIL_SMTP_PORT=465
EMAIL_SECURITY=SslOnConnect
EMAIL_USERNAME=
EMAIL_PASSWORD=
# Leave blank to use EMAIL_USERNAME as the sender address.
EMAIL_FROM_ADDRESS=
# Persistent random secret, at least 32 characters. Keep the same value across servers.
EMAIL_VERIFICATION_SECRET=
