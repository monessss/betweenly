# Copy to .env.accounts. Use a NEW MySQL database; old JSON data is not imported.
MYSQL_CONNECTION_STRING=Server=127.0.0.1;Port=3306;Database=betweenly_accounts;User ID=betweenly;Password=CHANGE_ME;SslMode=Preferred
# First boot only: allows CREATE TABLE IF NOT EXISTS in the pre-created database.
ACCOUNTS_INITIALIZE_SCHEMA=true
BETWEENLY_WEB_GATEWAY_PORT=5088
BETWEENLY_WEB_SERVICE_PORT=5141
# Optional Python executable; no frontend is started by this backend launcher.
BETWEENLY_PYTHON=
