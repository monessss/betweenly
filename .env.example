# Copy to .env. Loaded by scripts/start-mvp.ps1; never committed.
# Provider keys are optional defaults; Windows users can also save them in Connection Settings.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# TypeSafe Jev reviews DeepSeek's candidate. auto enables it when its key is filled.
TYPESAFE_API_KEY=
JEV_ENABLED=auto
JEV_MODEL=jev-1.14.0
JEV_BASE_URL=https://api.typesafe.ai/v1
# Optional: Python executable if python/py is not on PATH.
BETWEENLY_PYTHON=
