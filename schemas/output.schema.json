{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://betweenly.local/schemas/output.schema.json",
  "title": "Betweenly analysis output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "observations", "uncertainties", "reply_options", "clarifying_questions"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "status": { "type": "string", "enum": ["ok", "needs_context", "error"] },
    "observations": {
      "type": "array",
      "maxItems": 10,
      "items": { "$ref": "#/$defs/evidencedText" }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "recommendation": {
      "oneOf": [
        { "$ref": "#/$defs/recommendation" },
        { "type": "null" }
      ]
    },
    "reply_options": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "style"],
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "style": { "type": "string", "minLength": 1, "maxLength": 200 },
          "when_to_use": { "type": "string", "maxLength": 500 }
        }
      }
    },
    "clarifying_questions": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "error_message": { "type": "string", "maxLength": 1000 }
  },
  "$defs": {
    "evidencedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "evidence_refs"],
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "reason", "evidence_refs", "next_steps"],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "ask_follow_up",
            "continue_conversation",
            "share_experience",
            "make_invitation",
            "express_intent",
            "clarify_misunderstanding",
            "apologize",
            "slow_down",
            "accept_refusal",
            "end_contact",
            "gather_context"
          ]
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "evidence_refs": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "conditions": {
          "type": "array",
          "maxItems": 10,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "next_steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    }
  }
}

