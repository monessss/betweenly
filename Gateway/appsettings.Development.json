{
  "Urls": "http://127.0.0.1:5080",
  "Gateway": {
    "RequestTimeoutSeconds": 75,
    "Cors": {
      "AllowedOrigins": [
        "http://localhost:3000",
        "http://127.0.0.1:3000"
      ]
    },
    "DevelopmentAuth": {
      "Enabled": true
    },
    "Services": {
      "expression-style-service": {
        "BaseUrl": "http://127.0.0.1:5101",
        "GatewayKey": "dev-style-gateway-key",
        "HealthPath": "/readyz"
      },
      "contact-context-service": {
        "BaseUrl": "http://127.0.0.1:5102",
        "GatewayKey": "dev-context-gateway-key",
        "HealthPath": "/readyz"
      },
      "advice-service": {
        "BaseUrl": "http://127.0.0.1:5103",
        "GatewayKey": "dev-advice-gateway-key",
        "HealthPath": "/readyz"
      },
      "analysis-service": {
        "BaseUrl": "http://127.0.0.1:5104",
        "GatewayKey": "dev-analysis-gateway-key",
        "HealthPath": "/readyz"
      }
    },
    "ServiceCredentials": {
      "AdviceService": "dev-advice-service-key",
      "ContactContextService": "dev-context-service-key"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  }
}
